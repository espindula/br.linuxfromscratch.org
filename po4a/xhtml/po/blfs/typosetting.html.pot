#. type: Content of: <html><body><p><h4>
#: xhtml/upstream/blfs/typosetting.html:159
msgid "<a name=\"fonttable\"/>The table of fonts"
msgstr ""

#. type: Content of: <html><body><p><p>
#: xhtml/upstream/blfs/typosetting.html:161
msgid ""
"When I first revised this in 2011 I put all the fonts in one table, "
"and the numbers are"
msgstr ""

#. type: Content of: <html><body><p><p>
#: xhtml/upstream/blfs/typosetting.html:162
msgid ""
"referenced in various Lipsum and similar files. In 2018 I added a lot "
"more fonts, and"
msgstr ""

#. type: Content of: <html><body><p><p>
#: xhtml/upstream/blfs/typosetting.html:163
msgid ""
"put them in a second table to save renumbering things. Both those "
"tables are mostly"
msgstr ""

#. type: Content of: <html><body><p><p>
#: xhtml/upstream/blfs/typosetting.html:164
msgid ""
"in alphabetical order by the fontconfig names. More recently I have "
"found other fonts,"
msgstr ""

#. type: Content of: <html><body><p><p>
#: xhtml/upstream/blfs/typosetting.html:165
msgid ""
"and added them to a third table as I came across them. I have now "
"merged all three"
msgstr ""

#. type: Content of: <html><body><p><p>
#: xhtml/upstream/blfs/typosetting.html:166
msgid ""
"tables into one while trying to update to current HTML and CSS "
"standards. To help"
msgstr ""

#. type: Content of: <html><body><p><p>
#: xhtml/upstream/blfs/typosetting.html:167
msgid ""
"finding a font in this table I have now added indexes, both for the "
"names used in"
msgstr ""

#. type: Content of: <html><body><p><p>
#: xhtml/upstream/blfs/typosetting.html:168
msgid ""
"fontconfig, and for my (one-word or hyphenated) identifiers used in "
