#. type: Content of: <html><body><p><p>
#: xhtml/upstream/blfs/typosetting.html:172
msgid "<a href=\"idx2.html\">Index of fonts by my Identifier</a>"
msgstr ""

#. type: Content of: <html><body><p><p>
#: xhtml/upstream/blfs/typosetting.html:174
msgid "Most of the columns are, I hope, self-explanatory."
msgstr ""

#. type: Content of: <html><body><p><p>
#: xhtml/upstream/blfs/typosetting.html:175
msgid ""
"The 'Revised' column links to a XeLaTeX or LuaLaTeX source file with "
"the date when"
msgstr ""

#. type: Content of: <html><body><p><p>
#: xhtml/upstream/blfs/typosetting.html:176
msgid ""
"I revised the 'languages' PDF (before 2025-01-26 XeLaTeX, then "
"LuaLaTeX). It also"
msgstr ""

#. type: Content of: <html><body><p><p>
#: xhtml/upstream/blfs/typosetting.html:177
msgid ""
"links to my small caps sc.tex files where those exist. Many of my "
"files revised before"
msgstr ""

#. type: Content of: <html><body><p><p>
#: xhtml/upstream/blfs/typosetting.html:178
msgid "2024 exaggerate which codepoints or languages are available.)"
msgstr ""

#. type: Content of: <html><body><p><p>
#: xhtml/upstream/blfs/typosetting.html:179
msgid ""
"The 'Languages' links are to PDFs showing which of my example "
"languages are"
msgstr ""

#. type: Content of: <html><body><p><p>
#: xhtml/upstream/blfs/typosetting.html:180
msgid ""
"supported, and also to files of SC (Small Caps) support where the "
"font has those."
