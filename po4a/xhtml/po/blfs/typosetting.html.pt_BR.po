#. type: Content of: <html><body><p>
#: xhtml/upstream/blfs/typosetting.html:30
msgid ""
"If revisiting, quick links to <a href=\"#fonttable\">The table of fonts</a> "
"and <a href=\"changelog.html\">Changelog</a>"
msgstr ""
"Se revisitar, linques rápidos para <a href=\"#fonttable\">a tabela das "
"fontes</a> e <a href=\"changelog.html\">registro das mudanças</a>"

#. type: Content of: <html><body><h4>
#: xhtml/upstream/blfs/typosetting.html:33
